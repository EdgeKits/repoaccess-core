{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "npm install": "allow",
      "npm run *": "allow"
    },
    "edit": {
      "*": "ask",
      "wrangler.jsonc": "allow",
      "src/config/repoaccess.config.ts": "allow"
    },
    "read": {
      "*": "allow",
      "*.dev.vars*": "deny",
      "**/.dev.vars*": "deny",
      "*.dev.vars*.example": "allow",
      "**/.dev.vars*.example": "allow"
    }
  }
}
