{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm install)",
      "PowerShell(npm run:*)",
      "PowerShell(npm install)",
      "Edit(src/config/repoaccess.config.ts)",
      "Edit(wrangler.jsonc)"
    ],
    "deny": ["Read(.dev.vars)", "Read(.dev.vars.production)"]
  }
}
